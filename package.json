{
  "name": "godot-mcp-repo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Repo-root dev tooling only (lint). Not published; runtime code in server/ and launch/ stays zero-dependency.",
  "scripts": {
    "lint": "eslint . --max-warnings 59",
    "mutation": "stryker run",
    "mutation-all": "stryker run stryker.nightly.json",
    "coverage:launch": "node launch/tests/runner/coverage-gate.mjs",
    "coverage:server-new": "node launch/tests/runner/server-new-code-ratchet.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "c8": "^12.0.0",
    "eslint": "^9.39.2",
    "eslint-plugin-sonarjs": "^3.0.5",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.1.11"
  }
}
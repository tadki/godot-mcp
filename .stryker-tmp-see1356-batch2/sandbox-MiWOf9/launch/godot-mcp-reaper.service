[Unit]
Description=KingOfLikes godot-mcp resident stale-lease reaper (one-shot)
# Runs the reaper once. Mode (dry-run vs live) is decided by resident-reaper.sh
# from ~/.multica/godot-reaper.mode — the unit itself is mode-agnostic so the
# dry-run -> live cutover never needs a daemon-reload.

[Service]
Type=oneshot
# KOL_REPO_ROOT points at the checkout that owns the launch toolchain. The
# installer stamps the absolute path in here (SEE-1268 T2: repo-dirname is
# env-overridable via GODOT_MCP_REPO_DIRNAME, but this systemd unit must be
# rendered at install time by install-resident-reaper.sh — see K8 runbook).
ExecStart=@resolved@/launch/resident-reaper.sh

# Never let a wedged reaper (a stuck powershell.exe probe, a hung ss) pile up
# across timer ticks — one-shot plus a hard timeout keeps each tick bounded.
TimeoutStartSec=120
